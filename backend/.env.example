PORT=5000
NODE_ENV=development

# MongoDB
MONGODB_URI=mongodb://127.0.0.1:27017/social-media-automation

# JWT Secret Keys
ACCESS_TOKEN_SECRET=your_super_secret_access_key_change_me
REFRESH_TOKEN_SECRET=your_super_secret_refresh_key_change_me

# Redis (for BullMQ)
REDIS_URL=redis://127.0.0.1:6379

# External APIs
GROQ_API_KEY=your_groq_api_key_here
ZERNIO_API_KEY=your_zernio_api_key_here

# Cloudinary Storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# Frontend Configuration
FRONTEND_URL=http://localhost:5173
